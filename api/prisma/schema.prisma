// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CLIENT @map("client")
  ADMIN  @map("admin")

  @@map("user_role")
}

enum FieldType {
  TEXT
  TEXTAREA
  NUMBER
  DATE
  EMAIL
  PHONE
  RADIO
  SELECT
  CHECKBOX
}

model User {
  id                 String               @id @default(cuid())
  email              String               @unique
  name               String?
  passwordHash       String
  role               Role                 @default(CLIENT)
  submissions        Submission[]
  submissionActivity SubmissionActivity[]
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
}

model Workflow {
  id          String         @id @default(cuid())
  name        String
  description String?
  steps       WorkflowStep[]
  submissions Submission[]
  pages       WorkflowPage[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

model WorkflowPage {
  id         String          @id @default(cuid())
  workflowId String
  title      String
  order      Int
  workflow   Workflow        @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  fields     WorkflowField[]
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@unique([workflowId, order])
  @@index([workflowId])
}

model WorkflowField {
  id          String       @id @default(cuid())
  pageId      String
  label       String
  fieldType   FieldType    @default(TEXT)
  required    Boolean      @default(true)
  placeholder String?
  helpText    String?
  order       Int
  options     Json?
  page        WorkflowPage @relation(fields: [pageId], references: [id])
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@unique([pageId, order])
  @@index([pageId])
}

model WorkflowStep {
  id         String             @id @default(cuid())
  workflowId String
  title      String
  order      Int
  workflow   Workflow           @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  answers    SubmissionAnswer[]
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt
}

model Submission {
  id         String               @id @default(cuid())
  userId     String?
  workflowId String
  status     String
  user       User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  workflow   Workflow             @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  answers    SubmissionAnswer[]
  activities SubmissionActivity[]
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt
}

model SubmissionAnswer {
  id           String       @id @default(cuid())
  submissionId String
  stepId       String
  value        String
  submission   Submission   @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  step         WorkflowStep @relation(fields: [stepId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

model SubmissionActivity {
  id           String     @id @default(cuid())
  userId       String?
  submissionId String
  action       String
  oldStatus    String?
  newStatus    String
  user         User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@index([submissionId])
  @@index([userId])
}
